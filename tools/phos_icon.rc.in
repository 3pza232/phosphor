// 由 CMake 从本模板生成到构建目录（把绝对图标路径与版本号填进来），供 windres / rc
// 编译成链接期资源。Windows 只在**链接期**吃 .rc 里的图标 —— 运行时 glfwSetWindowIcon
// 改不动 exe 图标（那是另一件事，见 docs/content-packs.md）。
//
// 图标资源编号用 1：Windows 取编号最小的那枚 ICON 作 exe 的默认图标。
// 只用 RC 内置关键字，不 include windows.h，免得不同工具链的头文件搜索路径出岔子。

1 ICON "@PHOS_ICON_FILE@"

1 VERSIONINFO
  FILEVERSION @PHOS_VERSION_COMMA@
  PRODUCTVERSION @PHOS_VERSION_COMMA@
  FILEFLAGSMASK 0x3fL
  FILEFLAGS 0x0L
  FILEOS 0x40004L
  FILETYPE 0x1L
  FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "PHOSPHOR"
      VALUE "FileVersion", "@PHOS_VERSION@"
      VALUE "InternalName", "phosphor"
      VALUE "OriginalFilename", "phosphor.exe"
      VALUE "ProductName", "PHOSPHOR"
      VALUE "ProductVersion", "@PHOS_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
